#!/data/data/com.termux/files/usr/bin/bash
#
# ttd — загрузчик треков/видео с TikTok.
# Файлы создаются в папке, из которой запущена команда (не в папке скрипта),
# с названием и метаданными как на TikTok.
#
# Использование:
#   ttd                    # спросит URL и формат
#   ttd <URL>              # спросит формат (1/2)
#   ttd <URL> 1            # mp3 (музыка)
#   ttd <URL> 2            # mp4 (видео)

set -euo pipefail

COOKIES_FILE="${TTD_COOKIES:-$HOME/projects/ttd/cookies.txt}"

CACHE_DIR="$HOME/.cache/ttd"
mkdir -p "$CACHE_DIR"

# --- самообновление с GitHub (отключается: DLS_UPDATE=0) ----------------------
self_update() {
    [ "${DLS_UPDATE:-1}" = "1" ] || return 0
    local tmp="$CACHE_DIR/.update"
    curl -fsSL --max-time 10 "https://raw.githubusercontent.com/rival-afk/dls/main/ttd" -o "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
    [ -s "$tmp" ] && [ "$(head -c 2 "$tmp")" = "#!" ] || { rm -f "$tmp"; return 0; }
    cmp -s "$tmp" "$0" && { rm -f "$tmp"; return 0; }
    bash -n "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
    if mv "$tmp" "$0" 2>/dev/null; then
        chmod 755 "$0" 2>/dev/null || true
        echo "⟳ ttd обновлён с GitHub — перезапускаюсь…"
        exec env DLS_UPDATE=0 "$0" "$@"
    fi
    rm -f "$tmp"
}
self_update

# --- автообновление зависимостей (yt-dlp, jq, ffmpeg; отключается: DLS_LIBS_UPDATE=0) ---

# yt-dlp нужна curl_cffi для impersonation (обход JS-челленджей TikTok/YouTube).
# Без неё TikTok падает с "no impersonate target is available", а затем и с
# "Unable to extract universal data for rehydration" — обновление версии yt-dlp
# само по себе проблему не лечит. Спрашиваем сам yt-dlp (не python import), чтобы
# не ругаться зря на standalone-сборки, где зависимость уже вшита в бинарник.
# yt-dlp перечисляет цели curl_cffi и когда её нет — с пометкой "(unavailable)".
# Нас интересует только реально доступная цель (строка без пометки).
impersonation_ready() {
    yt-dlp --list-impersonate-targets 2>/dev/null | grep -i 'curl_cffi' | grep -qv 'unavailable'
}

ensure_impersonation() {
    [ "${DLS_LIBS_UPDATE:-1}" = "1" ] || return 0
    command -v yt-dlp >/dev/null 2>&1 || return 0
    local stamp="$CACHE_DIR/.impersonate_ok"
    [[ -f "$stamp" ]] && return 0
    if impersonation_ready; then
        touch "$stamp" 2>/dev/null || true
        return 0
    fi
    echo "⟳ yt-dlp: нет impersonation (curl_cffi) — ставлю зависимость…"
    python3 -m pip install --user -q --upgrade curl_cffi >/dev/null 2>&1 \
        || python3 -m pip install --user -q --upgrade --break-system-packages curl_cffi >/dev/null 2>&1 \
        || true
    if impersonation_ready; then
        echo "✓ impersonation доступен (curl_cffi)"
        touch "$stamp" 2>/dev/null || true
    else
        echo "⚠ curl_cffi не установлен — TikTok может падать на JS-челлендже (pip install curl_cffi)" >&2
    fi
}
ensure_impersonation

update_libs() {
    [ "${DLS_LIBS_UPDATE:-1}" = "1" ] || return 0
    local stamp now age last
    stamp="$CACHE_DIR/.libs_check"
    now=$(date +%s)
    if [[ -f "$stamp" ]]; then
        last=$(cat "$stamp" 2>/dev/null || echo 0)
        case "$last" in (*[!0-9]*|'') last=0 ;; esac
        age=$(( now - last ))
        [ "$age" -lt 86400 ] && return 0
    fi
    echo "$now" > "$stamp" 2>/dev/null || true

    # --- yt-dlp: самая критичная зависимость; сверяем с GitHub раз в день
    if command -v yt-dlp >/dev/null 2>&1; then
        local ytdlp_now latest
        ytdlp_now=$(yt-dlp --version 2>/dev/null || true)
        latest=$(curl -fsSL --max-time 10 "https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest" 2>/dev/null \
            | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name",""))' 2>/dev/null || true)
        if [[ -n "$latest" && "$latest" != "$ytdlp_now" ]]; then
            echo "⟳ yt-dlp: ${ytdlp_now:-?} → $latest"
            if yt-dlp -U >/dev/null 2>&1; then
                echo "✓ yt-dlp обновлён до $(yt-dlp --version 2>/dev/null || echo "$latest")"
            elif python3 -m pip install --user -q --upgrade yt-dlp >/dev/null 2>&1; then
                echo "✓ yt-dlp обновлён через pip"
            elif python3 -m pip install --user -q --upgrade --break-system-packages yt-dlp >/dev/null 2>&1; then
                echo "✓ yt-dlp обновлён через pip (--break-system-packages)"
            elif command -v pkg >/dev/null 2>&1; then
                pkg upgrade -y yt-dlp >/dev/null 2>&1 && echo "✓ yt-dlp обновлён через pkg" \
                    || echo "⚠ не удалось обновить yt-dlp (попробуй: yt-dlp -U)" >&2
            elif command -v brew >/dev/null 2>&1; then
                brew upgrade yt-dlp >/dev/null 2>&1 && echo "✓ yt-dlp обновлён через brew" \
                    || echo "⚠ не удалось обновить yt-dlp (попробуй: yt-dlp -U)" >&2
            else
                echo "⚠ не удалось обновить yt-dlp (попробуй: yt-dlp -U)" >&2
            fi
        fi
    fi

    # --- jq: pkg/brew, либо статический бинарь (если текущий можно перезаписать)
    if command -v jq >/dev/null 2>&1; then
        local jq_now jq_latest
        jq_now=$(jq --version 2>/dev/null | sed 's/^jq-//' || true)
        jq_latest=$(curl -fsSL --max-time 10 "https://api.github.com/repos/jqlang/jq/releases/latest" 2>/dev/null \
            | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name",""))' 2>/dev/null || true)
        jq_latest=${jq_latest#jq-}
        if [[ -n "$jq_latest" && -n "$jq_now" && "$jq_latest" != "$jq_now" ]]; then
            if command -v pkg >/dev/null 2>&1; then
                pkg upgrade -y jq >/dev/null 2>&1 && echo "✓ jq обновлён через pkg" || true
            elif command -v brew >/dev/null 2>&1; then
                brew upgrade jq >/dev/null 2>&1 && echo "✓ jq обновлён через brew" || true
            else
                local jq_bin asset new
                jq_bin=$(command -v jq)
                asset=""
                case "$(uname -s)" in
                    Linux*)
                        case "$(uname -m)" in
                            aarch64|arm64) asset="jq-linux-arm64" ;;
                            *)             asset="jq-linux-amd64" ;;
                        esac
                        ;;
                    Darwin*)                asset="jq-macos-amd64" ;;
                    MINGW*|MSYS*|CYGWIN*)   asset="jq-windows-amd64.exe" ;;
                esac
                if [[ -n "$asset" && -w "$jq_bin" ]]; then
                    new="${jq_bin}.new.$$"
                    if curl -fsSL --max-time 30 "https://github.com/jqlang/jq/releases/latest/download/$asset" -o "$new" 2>/dev/null; then
                        chmod +x "$new" 2>/dev/null
                        if mv "$new" "$jq_bin" 2>/dev/null; then
                            echo "✓ jq обновлён до $("$jq_bin" --version 2>/dev/null || echo "$jq_latest")"
                        else
                            rm -f "$new"
                        fi
                    else
                        rm -f "$new"
                    fi
                else
                    echo "⚠ jq $jq_latest доступен — текущий только для чтения/системный, обнови вручную." >&2
                fi
            fi
        fi
    fi

    # --- ffmpeg: обновляем только статическую сборку из нашей папки (раз в неделю)
    local ff_dir="$HOME/.local/share/dls/ffmpeg"
    local ff_bin=""
    [[ -f "$ff_dir/ffmpeg.exe" ]] && ff_bin="$ff_dir/ffmpeg.exe"
    [[ -z "$ff_bin" && -f "$ff_dir/ffmpeg" ]] && ff_bin="$ff_dir/ffmpeg"
    if [[ -n "$ff_bin" ]]; then
        local ff_stamp ff_now ff_last
        ff_stamp="$CACHE_DIR/.ffmpeg_check"
        ff_now=$(date +%s)
        ff_last=$(cat "$ff_stamp" 2>/dev/null || echo 0)
        case "$ff_last" in (*[!0-9]*|'') ff_last=0 ;; esac
        if (( ff_now - ff_last >= 604800 )); then
            echo "$ff_now" > "$ff_stamp" 2>/dev/null || true
            echo "⟳ Обновляю ffmpeg (статическая сборка BtbN)…"
            local zip tmp bin f dest
            zip="$CACHE_DIR/ffmpeg.zip"
            tmp="$CACHE_DIR/_ffmpeg_tmp"
            if curl -fsSL --max-time 600 "https://github.com/BtbN/FFmpeg-Builds/releases/latest/download/ffmpeg-master-latest-win64-gpl.zip" -o "$zip" 2>/dev/null; then
                rm -rf "$tmp"; mkdir -p "$tmp"
                if command -v powershell.exe >/dev/null 2>&1; then
                    powershell.exe -NoProfile -Command "Expand-Archive -Force '$zip' '$tmp'" >/dev/null 2>&1 || true
                elif command -v unzip >/dev/null 2>&1; then
                    unzip -qo "$zip" -d "$tmp" >/dev/null 2>&1 || true
                fi
                bin=$(find "$tmp" -maxdepth 3 -type d -name bin 2>/dev/null | head -n 1)
                if [[ -n "$bin" ]]; then
                    for f in "$bin"/*; do
                        dest="$ff_dir/${f##*/}"
                        mv -f "$dest" "$dest.old" 2>/dev/null || true
                        if ! cp -f "$f" "$dest" 2>/dev/null; then
                            mv -f "$dest.old" "$dest" 2>/dev/null || true
                        else
                            rm -f "$dest.old"
                        fi
                    done
                    echo "✓ ffmpeg обновлён"
                else
                    echo "⚠ не удалось распаковать ffmpeg" >&2
                fi
                rm -rf "$tmp"; rm -f "$zip"
            else
                echo "⚠ не удалось скачать ffmpeg" >&2
            fi
        fi
    fi
}
update_libs


# Провайдер режет хост коротких ссылок (vt./vm.tiktok.com) по TCP, при этом
# сам www.tiktok.com и CDN доступны. Поэтому короткие ссылки резолвим в
# канонический URL сторонним API (tikwm.com — не TikTok, блокировке не
# подпадает); если API недоступен — используется исходный URL как есть.
is_shortlink() {
    case "$1" in
        'http://vt.tiktok.com/'*|'https://vt.tiktok.com/'*|\
        'http://vm.tiktok.com/'*|'https://vm.tiktok.com/'*|\
        'http://m.tiktok.com/v/'*) return 0 ;;
        *) return 1 ;;
    esac
}

resolve_shortlink() {
    local url="$1"
    is_shortlink "$url" || { printf '%s\n' "$url"; return 0; }
    local full
    full=$(curl -sS --get --max-time 15 \
        --data-urlencode "url=$url" \
        'https://www.tikwm.com/api/' 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin).get("data") or {}
    vid = str(d.get("id") or "")
    uid = (d.get("author") or {}).get("unique_id") or ""
    print("https://www.tiktok.com/@%s/video/%s" % (uid or "_", vid))
except Exception:
    pass
' 2>/dev/null || true)
    if [[ -n "$full" ]]; then
        printf '%s\n' "$full"
    else
        echo '⚠ tikwm недоступен — пробую исходную ссылку' >&2
        printf '%s\n' "$url"
    fi
}

trim_thumbnail() {
    local img="$1"
    python3 -c "
from PIL import Image
import sys

def is_solid(col_pixels, tol=3):
    r0, g0, b0 = col_pixels[0]
    return all(abs(r - r0) <= tol and abs(g - g0) <= tol and abs(b - b0) <= tol
               for r, g, b in col_pixels)

img = Image.open(sys.argv[1]).convert('RGB')
px = img.load()
w, h = img.size
cols = [[px[x, y] for y in range(h)] for x in range(w)]

left = 0
while left < w:
    if is_solid(cols[left]):
        left += 1
    else:
        break

right = w - 1
while right > left:
    if is_solid(cols[right]):
        right -= 1
    else:
        break

if left > 0 or right < w - 1:
    img = img.crop((left, 0, right + 1, h))

out = sys.argv[1].rsplit('.', 1)[0] + '_trimmed.jpg'
img.save(out, 'JPEG', quality=95)
print(out)
" "$img"
}

embed_thumbnail() {
    local audio="$1"
    local thumb="$2"
    local tmp="${audio}.tmp.mp3"
    if ffmpeg -y -i "$audio" -i "$thumb" \
        -map 0:a -map 1:v -c:a copy \
        -metadata:s:v title="Album cover" \
        -metadata:s:v comment="Cover (front)" \
        "$tmp" 2>/dev/null; then
        mv "$tmp" "$audio"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Снапшот: какие jpg/webp лежат в папке до запуска yt-dlp.
snapshot_covers() {
    find "$PWD" -maxdepth 1 \( -name '*.jpg' -o -name '*.webp' \) -print 2>/dev/null | sort \
        > "$CACHE_DIR/.covers_before"
}

# обложки, записанные текущим запуском yt-dlp (после снапшота;
# если снапшота нет — старый путь: новее маркера)
current_covers() {
    if [[ -f "$CACHE_DIR/.covers_before" ]]; then
        find "$PWD" -maxdepth 1 \( -name '*.jpg' -o -name '*.webp' \) -print 2>/dev/null | sort \
            | comm -13 "$CACHE_DIR/.covers_before" - 2>/dev/null
        return 0
    fi
    [[ -f "$CACHE_DIR/.marker" ]] || return 0
    find "$PWD" -maxdepth 1 \( -name '*.jpg' -o -name '*.webp' \) \
        -newer "$CACHE_DIR/.marker" -print 2>/dev/null
}

# после встраивания обложки в файл её временные файлы удаляются
clean_covers() {
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] && rm -f "$f"
    done < <(current_covers)
    rm -f "$CACHE_DIR/.covers_before"
}

# TikTok периодически отдаёт страницу без universal data после JS-челленджа —
# это флап, а не постоянная ошибка (иногда тот же ролик качается со 2-й попытки).
run_ytdlp() {
    local url="$1"; shift
    local attempt max_attempts=1 rc=0
    case "$url" in
        *tiktok.com*|*tiktokv.com*) max_attempts=3 ;;
    esac
    for (( attempt=1; attempt<=max_attempts; attempt++ )); do
        rc=0
        "$@" "$url" || rc=$?
        (( rc == 0 )) && return 0
        if (( attempt < max_attempts )); then
            echo "⟳ Повтор ${attempt}: TikTok иногда отдаёт страницу без данных…" >&2
            sleep 2
        fi
    done
    return "$rc"
}

download_music() {
    local url="$1"
    echo
    echo "▶ Скачиваю (mp3): $url"

    local args=(
        -x
        --audio-format mp3
        --audio-quality 0
        --write-thumbnail
        --convert-thumbnails jpg
        --embed-metadata
        --no-playlist
        --newline
        -o '%(title)s.%(ext)s'
    )
    [[ -f "$COOKIES_FILE" ]] && args+=(--cookies "$COOKIES_FILE")
    snapshot_covers
    touch "$CACHE_DIR/.marker"
    if ! run_ytdlp "$url" yt-dlp "${args[@]}"; then
        echo "✖ Не удалось скачать (mp3): $url" >&2
        clean_covers
        return 1
    fi

    local new
    new=$(ls -t "$PWD"/*.mp3 2>/dev/null | head -n 1 || true)
    if [[ -z "$new" ]]; then
        # yt-dlp мог оставить только обложку (например, если mp3 не создался)
        clean_covers
        echo "✓ Готово (mp3 в текущей папке)."
        return
    fi

    local f thumb=""
    while IFS= read -r f; do
        thumb="$f"
        break
    done < <(current_covers)
    if [[ -n "$thumb" ]]; then
        local trimmed
        trimmed=$(trim_thumbnail "$thumb" || true)
        if [[ -n "$trimmed" && -f "$trimmed" ]]; then
            echo "▶ Встраиваю обложку..."
            if ! embed_thumbnail "$new" "$trimmed"; then
                echo "⚠ Не удалось встроить обложку: $new" >&2
            fi
        fi
    fi
    clean_covers

    echo "✓ Сохранено: $new"
}

download_video() {
    local url="$1"
    echo
    echo "▶ Скачиваю (mp4): $url"

    local args=(
        -f 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best'
        --merge-output-format mp4
        --write-thumbnail
        --convert-thumbnails jpg
        --embed-metadata
        --no-playlist
        --newline
        -o '%(title)s.%(ext)s'
    )
    [[ -f "$COOKIES_FILE" ]] && args+=(--cookies "$COOKIES_FILE")
    snapshot_covers
    touch "$CACHE_DIR/.marker"
    if ! run_ytdlp "$url" yt-dlp "${args[@]}"; then
        echo "✖ Не удалось скачать (mp4): $url" >&2
        clean_covers
        return 1
    fi

    local new
    new=$(ls -t "$PWD"/*.mp4 2>/dev/null | head -n 1 || true)
    if [[ -z "$new" ]]; then
        # yt-dlp мог оставить только обложку (например, если mp4 не создался)
        clean_covers
        echo "✓ Готово (mp4 в текущей папке)."
        return
    fi

    local f thumb=""
    while IFS= read -r f; do
        thumb="$f"
        break
    done < <(current_covers)
    if [[ -n "$thumb" ]]; then
        local trimmed
        trimmed=$(trim_thumbnail "$thumb" || true)
        if [[ -n "$trimmed" && -f "$trimmed" ]]; then
            echo "▶ Встраиваю обложку..."
            local tmp="${new}.tmp.mp4"
            if ffmpeg -y -i "$new" -i "$trimmed" \
                -map 0 -map 1 -c copy \
                -metadata:s:v title="Album cover" \
                -metadata:s:v comment="Cover (front)" \
                "$tmp" 2>/dev/null; then
                mv "$tmp" "$new"
            else
                rm -f "$tmp"
                echo "⚠ Не удалось встроить обложку: $new" >&2
            fi
        fi
    fi
    clean_covers

    echo "✓ Сохранено: $new"
}

ask_format() {
    {
        echo "Выбери формат:"
        echo "  1 — mp3 (музыка)"
        echo "  2 — mp4 (видео)"
        printf "Твой выбор [1/2]: "
    } > /dev/tty
    read -r format_choice < /dev/tty || true
    case "$format_choice" in
        2) echo "mp4" ;;
        *) echo "mp3" ;;
    esac
}

download() {
    local url="$1"
    local format="${2:-}"

    # короткая ссылка (vt./vm.tiktok.com) может быть зарезана провайдером:
    # переводим в каноническую https://www.tiktok.com/@user/video/<id>
    if is_shortlink "$url"; then
        echo "▶ Резолвлю короткую ссылку..."
        url=$(resolve_shortlink "$url")
        echo "▶ Ссылка: $url"
    fi

    if [[ -z "$format" ]]; then
        format=$(ask_format)
    fi
    
    local download_fn="download_music"
    [[ "$format" == "mp4" ]] && download_fn="download_video"
    
    $download_fn "$url"
}

resolve_format() {
    case "${1:-}" in
        1) echo "mp3" ;;
        2) echo "mp4" ;;
        *) echo "" ;;
    esac
}

if (( $# >= 1 )); then
    case "$1" in
        -h|--help)
            sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
    esac
    if (( $# >= 2 )); then
        fmt=$(resolve_format "$2")
        download "$1" "$fmt"
    else
        download "$1"
    fi
    exit 0
fi

echo "ttd — загрузчик треков/видео с TikTok (mp3/mp4 + обложка + метаданные)"
echo "Пустая строка — выход. Ctrl+C — прервать загрузку."
echo

while :; do
    printf 'Вставь URL: '
    read -r url || true
    url="${url//[$'\r\n']/}"
    if [[ -z "$url" ]]; then
        echo "Пока!"
        exit 0
    fi
    download "$url"
done
